# ---- Priva Comment 环境配置示例 ----
# 复制为 .env 后按需修改（Vercel 部署时在项目 Settings → Environment Variables 配置同名变量）

# 存储后端：留空或 sqlite = 本地 SQLite 文件；mongo = MongoDB（Vercel 必须用 mongo）
DB_TYPE=

# MongoDB 连接串与库名（DB_TYPE=mongo 时必填）
MONGODB_URI=
MONGODB_DB=kcomment

# 服务端口
PORT=3000

# 管理后台密码兜底（可留空；正常流程在首次启动的安装向导里设置）
ADMIN_PASSWORD=

# JWT 签名密钥兜底（初始化向导会自动生成并持久化强随机密钥，可不填）
JWT_SECRET=

# 数据库文件路径（仅 SQLite 后端，默认 data/comments.db）
DB_PATH=

# 是否开启演示数据（首次启动时自动写入示例评论）
SEED_DEMO=true

# 跨域白名单：允许挂评论区的站点来源，逗号分隔。* 表示不限制（不推荐生产使用）
# 例：ALLOWED_ORIGINS=https://www.uyu.cc.cd,https://uyu.cc.cd
ALLOWED_ORIGINS=*

# 是否信任反向代理的 X-Forwarded-For（Vercel/Nginx 后面保持 1 即可）
TRUST_PROXY=1
